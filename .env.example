# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

AMAZON_ASSOCIATE_TAG=peptides03-20
APIFY_TOKEN=apify_api_...

MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.<your-domain>
MAILGUN_LIST=deals@mg.<your-domain>
MAILGUN_REGION=
